+const fs = require('fs');
+const vm = require('vm');
+const ts = require('typescript');
+const assert = require('node:assert/strict');
+
+function load(file, dependencies, globals = {}) {
+  const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.ReactJSX, target: ts.ScriptTarget.ES2020 },
+  }).outputText;
+  const exports = {};
+  vm.runInNewContext(code, { exports, require: name => {
+    if (!(name in dependencies)) throw new Error(`Unexpected dependency: ${name}`);
+    return dependencies[name];
+  }, ...globals }, { filename: file });
+  return exports;
+}
+const difficultyModule = load('src/game/gatorDifficulty.ts', {});
+const { gatorDifficulty } = difficultyModule;
+for (const frame of [1, 2, 3, 0, -1, 11, NaN, Infinity, 4.5]) assert.equal(gatorDifficulty(frame), null);
+assert.equal(gatorDifficulty(4), gatorDifficulty(6), 'Same tier must preserve its timer across frames');
+assert.equal(gatorDifficulty(7), gatorDifficulty(9));
+for (const [frame, cooldown, warning, active] of [[4, 14000, 1800, 800], [7, 10000, 1500, 1100], [10, 8000, 1200, 1400]]) {
+  const tier = gatorDifficulty(frame);
+  assert.equal(tier.cooldownMs, cooldown);
+  assert.equal(tier.warningMs, warning);
+  assert.equal(tier.activeMs, active);
+}
+
+// Run the real overlay's effects and timeout callbacks with a deterministic clock.
+function harness(random = 0) {
+  let now = 0, nextId = 0, cursor = 0, active = false, attacks = 0;
+  const timers = new Map(), hooks = [], effects = [], listeners = new Map();
+  const react = {
+    useState(initial) { const i = cursor++; if (!(i in hooks)) hooks[i] = initial; return [hooks[i], v => { hooks[i] = v; }]; },
+    useRef(initial) { const i = cursor++; if (!(i in hooks)) hooks[i] = { current: initial }; return hooks[i]; },
+    useEffect(fn, deps) { const i = cursor++, old = hooks[i]; if (!old || deps.some((v, n) => !Object.is(v, old.deps[n]))) { effects.push(() => { old?.cleanup?.(); hooks[i] = { deps, cleanup: fn() }; }); } },
+  };
+  const animate = { default: { View: 'AnimatedView' }, useSharedValue: v => react.useRef(v === undefined ? { value: 0 } : { value: v }).current,
+    useAnimatedStyle: fn => fn(), withSequence: (...v) => v.at(-1), withTiming: v => v,
+    Easing: { in: v => v, out: v => v, back: () => 0, quad: 0 } };
+  const Overlay = load('src/components/LaneHazardOverlay.web.tsx', {
+    react, 'react/jsx-runtime': { jsx: () => null, jsxs: () => null },
+    'react-native': { StyleSheet: { create: v => v, absoluteFill: {} } },
+    'react-native-reanimated': animate,
+    '@/src/game/gatorDifficulty': difficultyModule,
+    '@/src/game/hazards': { setWebHazardActive: (_id, value) => { active = value; if (value) attacks++; } },
+  }, {
+    Math: { random: () => random, floor: Math.floor },
+    setTimeout: (fn, ms) => { const id = ++nextId; timers.set(id, { fn, time: now + ms }); return id; },
+    clearTimeout: id => timers.delete(id),
+    window: { addEventListener: (name, fn) => listeners.set(name, fn), removeEventListener: name => listeners.delete(name) },
+  }).default;
+  return {
+    render(frame, enabled = true) { cursor = 0; Overlay({ frame, enabled }); effects.splice(0).forEach(fn => fn()); },
+    advance(ms) { const end = now + ms; let steps = 0; while (true) {
+      const next = [...timers].filter(([, t]) => t.time <= end).sort((a, b) => a[1].time - b[1].time)[0];
+      if (!next) break;
+      assert(++steps < 10000, 'Timer loop must remain bounded');
+      now = next[1].time; timers.delete(next[0]); next[1].fn();
+    } now = end; },
+    impact(powerup = null, hazard = 'alley-gator') { listeners.get('super-strike-hazard')?.({ detail: { type: 'pop-wall-impact', hazard, powerup, ballX: 0 } }); },
+    unmount() { hooks.forEach(h => h?.cleanup?.()); },
+    get active() { return active; }, get attacks() { return attacks; }, get pending() { return timers.size; },
+  };
+}
+for (const random of [0, 0.999999]) {
+  const h = harness(random);
+  for (const frame of [1, 2, 3]) { h.render(frame); h.advance(120000); assert.equal(h.attacks, 0); assert.equal(h.pending, 0); }
+  h.unmount();
+}
+for (const frame of [4, 7, 10]) {
+  for (const random of [0, 0.999999]) {
+    const h = harness(random), d = gatorDifficulty(frame);
+    const wait = d.cooldownMs + Math.floor(random * d.cooldownJitterMs);
+    h.render(frame); h.advance(wait + d.warningMs - 1); assert.equal(h.active, false);
+    h.advance(1); assert.equal(h.active, true); assert.equal(h.attacks, 1);
+    h.advance(d.activeMs); assert.equal(h.active, false);
+    h.unmount(); h.advance(120000); assert.equal(h.attacks, 1); assert.equal(h.pending, 0);
+  }
+}
+{
+  const h = harness(); h.render(4); h.advance(7000); h.render(5); h.advance(8800);
+  assert.equal(h.active, true, 'Advancing within a tier must not restart the cooldown');
+  h.render(7); assert.equal(h.active, false, 'Tier changes clear the previous attack');
+  h.advance(11500); assert.equal(h.active, true);
+  h.render(7, false); assert.equal(h.active, false); h.advance(120000); assert.equal(h.pending, 0);
+  h.render(1); assert.equal(h.active, false); assert.equal(h.pending, 0); h.unmount();
+}
+for (const powerup of [null, 'bomb', 'lightning']) {
+  const h = harness(); h.render(4); h.advance(15800);
+  h.impact(null, 'pop-wall'); assert.equal(h.active, true, 'Other hazards cannot consume the Gator');
+  h.impact(powerup); assert.equal(h.active, false);
+  h.impact(powerup); h.advance(860 + 14000 + 1800); assert.equal(h.attacks, 2, 'An impact must schedule exactly one next attack');
+  h.unmount(); h.advance(120000); assert.equal(h.pending, 0);
+}
+for (const elapsed of [1, 14500, 15800, 15900]) {
+  const h = harness(); h.render(4); h.advance(elapsed); h.unmount(); h.advance(120000);
+  assert.equal(h.active, false); assert.equal(h.pending, 0, 'Exit must clear cooldown, warning and attack timers');
+}
+console.log('Gator difficulty passed: three safe frames, gradual tiers, full warnings, preserved cooldowns, power-ups, and exit/reset cleanup.');
