+++ b/frontend/src/game/gatorDifficulty.ts
@@ -0,0 +1,19 @@
+export interface GatorDifficulty {
+  cooldownMs: number;
+  cooldownJitterMs: number;
+  warningMs: number;
+  activeMs: number;
+}
+
+const INTRO: GatorDifficulty = { cooldownMs: 14000, cooldownJitterMs: 4000, warningMs: 1800, activeMs: 800 };
+const LATER: GatorDifficulty = { cooldownMs: 10000, cooldownJitterMs: 4000, warningMs: 1500, activeMs: 1100 };
+const FINAL: GatorDifficulty = { cooldownMs: 8000, cooldownJitterMs: 4000, warningMs: 1200, activeMs: 1400 };
+
+// Stable tier objects keep the clock running across frames within a tier.
+// A new game always starts with three frames free of Gator attacks.
+export function gatorDifficulty(frame: number): GatorDifficulty | null {
+  if (!Number.isInteger(frame) || frame < 4 || frame > 10) return null;
+  if (frame <= 6) return INTRO;
+  if (frame <= 9) return LATER;
+  return FINAL;
+}
